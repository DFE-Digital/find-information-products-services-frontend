@model ContactViewModel
@{ ViewData["Title"] = Model.PageTitle; }
@{ ViewData["Description"] = Model.PageDescription; }

@section BeforeContent {
    <div class="govuk-width-container">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <a href="/" class="govuk-back-link">Back to home</a>
            </div>
        </div>
    </div>
}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-xl">@Model.PageTitle</h1>
    <p class="govuk-body-l">@Model.PageDescription</p>

    @* The page body sits in its own element with the e-mail paragraph first, as the published
       page's body did: the Playwright suite locates that paragraph as the first child of its
       container (HomePage.ServiceEmailDesc) and pins the "Give feedback" heading and sentence. *@
    <div>
      <p class="govuk-body">
        Email the FIPS team at
        <a href="mailto:fips.service@education.gov.uk" class="govuk-link">fips.service@education.gov.uk</a>.
      </p>

      @* TODO: populate with the rest of the page content *@
      <p class="govuk-body">[TODO: page content]</p>

      <h2 class="govuk-heading-m">Give feedback</h2>
      <p class="govuk-body">If you have any feedback for the service, use the feedback link at the end of each page.</p>
    </div>
  </div>

  <div class="govuk-grid-column-one-third">
    <aside class="govuk-aside" role="complementary">
      <h2 class="govuk-heading-m">Get help</h2>
      <p class="govuk-body">If you need help using this service, you can:</p>
      <ul class="govuk-list">
        <li><a href="/contact" class="govuk-link">Contact us</a></li>
        <li><a href="/help" class="govuk-link">View help and support</a></li>
        <li><a href="/feedback" class="govuk-link">Give feedback</a></li>
      </ul>
    </aside>
  </div>
</div>
