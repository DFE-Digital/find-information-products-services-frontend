@{
    ViewData["Title"] = "Contact us";
}

@section BeforeContent {
    <div class="govuk-width-container">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <a asp-controller="Home" asp-action="Index" class="govuk-back-link">Back to home</a>
            </div>
        </div>
    </div>
}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-xl">Contact us</h1>

    @* The e-mail paragraph is the first child of its own element:
       the Playwright suite locates it as such (HomePage.ServiceEmailDesc). *@
    <div>
      <p class="govuk-body">
        Email <a href="mailto:fips.service@education.gov.uk" class="govuk-link">fips.service@education.gov.uk</a>
        if you have a question about this service.
      </p>

      <h2 class="govuk-heading-l">Give feedback</h2>
      <p class="govuk-body">If you have any feedback for the service, use the feedback link at the end of each page.</p>
    </div>
  </div>

  <div class="govuk-grid-column-one-third">
    <aside class="govuk-aside" role="complementary">
      <h2 class="govuk-heading-m">Related content</h2>
      <ul class="govuk-list">
        <li><a asp-controller="About" asp-action="Index" class="govuk-link">About this service</a></li>
        <li><a asp-controller="Updates" asp-action="Index" class="govuk-link">Keep information updated</a></li>
      </ul>
    </aside>
  </div>
</div>
