<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings; the workflow passes this file to dotnet test with the XPlat Code Coverage collector. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Razor views compile into generated classes; their coverage says nothing a person can act on. -->
          <ExcludeByFile>**/*.cshtml</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
