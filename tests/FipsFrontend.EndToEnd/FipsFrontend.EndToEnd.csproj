<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The browser-driven suite, copied as it stood from the separate tests repository so that the
    application and the tests that describe it change in the same commits. It runs against a
    running instance of the application (see README.md), is not part of the pipeline's test run,
    and is known not to pass in full - each change to the application now shows exactly which of
    these tests it moves.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>find_information_products_services_tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	<!--comment later change GenerateProgramFile to true false  -->
	<GenerateProgramFile>true</GenerateProgramFile>
	<StartupObject></StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Deque.AxeCore.Playwright" />
    <PackageReference Include="ExtentReports" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright.NUnit" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
    <!-- Referenced directly so that this version, not the 5.0.0 that ExtentReports pulls in through
         RazorEngine.NetCore.nixFix, is the one restored: 5.0.0 carries a critical advisory
         (GHSA-rxg9-xrhp-64gj), and ExtentReports has no release that moves off it. -->
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <!-- The settings template and a machine's local copy travel with the built assembly, where SuiteSettings reads them. -->
  <ItemGroup>
    <None Update="testsettings.json;testsettings.local.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Playwright.NUnit" />
    <Using Include="NUnit.Framework" />
    <Using Include="System.Text.RegularExpressions" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

</Project>
