<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Scenarios host the whole application in-process and describe what a visitor meets: a URL, a
    response, a page. Every outbound HTTP client the application registers is replaced by a stand-in
    that records what was asked of it, so a scenario can state what a page must not reach for as
    firmly as what it must render.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- See TestSupport/Html.cs. -->
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FipsFrontend\FipsFrontend.csproj" />
    <ProjectReference Include="..\..\src\Compass.FipsApi.Contracts\Compass.FipsApi.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The stub's scenario files and resolver, so the tests serve in-process exactly what the stub serves over HTTP.
         Linked rather than referenced: two web projects with top-level statements would both be named Program. -->
    <Compile Include="..\..\src\Compass.FipsApi.Stub\Scenarios.cs" Link="TestSupport\Scenarios.cs" />
    <None Include="..\..\src\Compass.FipsApi.Stub\scenarios\**\*.json" Link="scenarios\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
