<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GovukNotify" Version="7.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.9" />
    <PackageReference Include="Microsoft.Identity.Web" Version="2.15.1" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="2.15.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.RateLimiting" Version="7.0.0-rc.2.22476.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\govuk-frontend\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The stylesheet step runs the Sass compiler from node_modules, so the build installs the npm packages itself.
    Incremental: a stamp file keyed on the manifests, so an ordinary build does not pay for an install.
    Skipped under CI, where the workflow's "npm ci" is the right tool and a lockfile mismatch must fail.
    ContinueOnError on the install only: an offline machine that already has node_modules must still build,
    and a genuinely missing package still stops the build at BuildCSS, where the error names the missing import.
  -->
  <ItemGroup>
    <NpmManifests Include="package.json" />
    <NpmManifests Include="package-lock.json" Condition="Exists('package-lock.json')" />
  </ItemGroup>

  <PropertyGroup>
    <!-- BaseIntermediateOutputPath (obj/) is defined before the project body is evaluated; IntermediateOutputPath is not. -->
    <NpmInstallStampFile>$(BaseIntermediateOutputPath)npm-install.stamp</NpmInstallStampFile>
  </PropertyGroup>

  <Target Name="NpmInstall" BeforeTargets="BuildCSS" Condition="'$(CI)' != 'true'" Inputs="@(NpmManifests)" Outputs="$(NpmInstallStampFile)">
    <Message Importance="high" Text="Installing npm packages (first build, or a manifest changed)..." />
    <Exec Command="npm install --no-audit --no-fund" ContinueOnError="true" />
    <Touch Files="$(NpmInstallStampFile)" AlwaysCreate="true" />
  </Target>

  <Target Name="BuildCSS" BeforeTargets="Build" DependsOnTargets="NpmInstall">
    <Exec Command="npm run build-css" ContinueOnError="false" />
  </Target>

  <Target Name="WatchCSS" Condition="'$(Configuration)' == 'Debug' AND '$(WatchCSS)' == 'true'">
    <Exec Command="npm run watch-css" ContinueOnError="true" />
  </Target>

</Project>
