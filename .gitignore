# Browser-driven suite (tests/FipsFrontend.EndToEnd): its report, and the per-machine copy of
# testsettings.json that points it at a running application
playwright-report/
testsettings.local.json

# Per-environment settings files may hold real values and stay on the machine that made them
# (appsettings.Development.json for local overrides). appsettings.json is committed: every value in
# it is empty or a default, and the application runs from it as it is. The "ci" file is placeholders.
appsettings.*.json
!appsettings.ci.json

# The seed entry point's record of the Strapi it started: pid, database path, and a throwaway token.
tests/FipsFrontend.EndToEnd/seed/.cms-*.json
