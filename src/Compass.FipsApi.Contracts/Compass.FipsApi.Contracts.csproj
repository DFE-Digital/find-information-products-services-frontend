<Project Sdk="Microsoft.NET.Sdk">

  <!-- The COMPASS service-register API's response records (generated from its source; regenerate, never edit),
       the one deserialiser configuration, and the observation of members the records do not name.
       Depends on nothing in this application, so COMPASS can publish it later. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
