@model AdminViewModel
@{ ViewData["Title"] = Model.PageTitle; }
@{ ViewData["Description"] = Model.PageDescription; }


@section BeforeContent {

  <div class="dfe-masthead">
        <div class="govuk-width-container">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    <h1 class="govuk-heading-xl dfe-masthead--title govuk-!-margin-bottom-0">
                        Admin dashboard
                    </h1>

                </div>
            </div>
        </div>
    </div>

}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <div class="dfe-card-group">
      <a asp-controller="Admin" asp-action="ProductManage" class="dfe-card">
        <h2 class="dfe-card-title">Manage products</h2>
        <p class="dfe-card-content">
          View, edit, and change the state of products: @Model.PublishedProductsCount published, @Model.CategoryTypesCount category types.
        </p>
      </a>
      <a asp-controller="Admin" asp-action="CmdbMatching" class="dfe-card">
        <h2 class="dfe-card-title">CMDB matching</h2>
        <p class="dfe-card-content">
          Match products to their CMDB entries.
        </p>
      </a>
      <a asp-controller="Admin" asp-action="UnmappedProducts" class="dfe-card">
        <h2 class="dfe-card-title">Products without a CMDB system ID</h2>
        <p class="dfe-card-content">
          Products not yet linked to a CMDB entry.
        </p>
      </a>
      <a asp-controller="Admin" asp-action="UnmappedCmdbEntries" class="dfe-card">
        <h2 class="dfe-card-title">Unmapped CMDB entries</h2>
        <p class="dfe-card-content">
          CMDB entries with no product in this service.
        </p>
      </a>
    </div>
  </div>
</div>
