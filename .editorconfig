root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,mjs,cjs,ts,tsx,jsx,json,yml,yaml,csproj,props,targets,slnx,runsettings,scss,css}]
indent_size = 2

[*.md]
# A trailing double space is a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
